# ─── OCD LIVE — variables d'environnement ───────────────────────────────
# Sur Railway, deux variables suffisent :
#   DATABASE_URL    = ${{Postgres.DATABASE_URL}}
#   GEMINI_API_KEY  = clé gratuite Google AI Studio (réceptionniste IA) : https://aistudio.google.com/apikey
# Tout le reste a une valeur par défaut. Les réglages métier (numéro Mobile Money, WhatsApp,
# emails de l'équipe, horaires, prix) se modifient dans l'espace équipe → Réglages.

DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/ocdlive

# ── Réceptionniste IA : une clé suffit ──
# Google Gemini (offre gratuite, choisi en priorité s'il a une clé)
GEMINI_API_KEY=
# Anthropic Claude (payant, facultatif)
ANTHROPIC_API_KEY=
# Forcer un fournisseur : gemini ou claude (vide = automatique)
AI_PROVIDER=
# Modèle Gemini (défaut : gemini-3.5-flash-lite, le plus rapide de l'offre gratuite)
GEMINI_MODEL=

# ── Premier démarrage uniquement : crée le premier compte de l'espace équipe ──
# À supprimer une fois le compte créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Facultatif ──
# Envoi des emails (notifications équipe, confirmations clients) via Resend.
RESEND_API_KEY=
# Développement local uniquement : paiements simulés (ignoré en production).
PAYMENT_PROVIDER=demo
