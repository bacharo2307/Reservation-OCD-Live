# ─── OCD LIVE — variables d'environnement ───────────────────────────────
# Sur Railway, seules deux variables sont nécessaires :
#   DATABASE_URL       = ${{Postgres.DATABASE_URL}}
#   ANTHROPIC_API_KEY  = clé de l'API Claude (réceptionniste IA)
# Tout le reste a une valeur par défaut. Les réglages métier (numéro Mobile Money, WhatsApp,
# emails de l'équipe, horaires, prix) se modifient dans l'espace équipe → Réglages.

DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/ocdlive
ANTHROPIC_API_KEY=

# ── Premier démarrage uniquement : crée le premier compte de l'espace équipe ──
# À supprimer une fois le compte créé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Facultatif ──
# Envoi des emails (notifications équipe, confirmations clients) via Resend.
RESEND_API_KEY=
# Développement local uniquement : paiements simulés (ignoré en production).
PAYMENT_PROVIDER=demo
