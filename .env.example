# ─── OCD LIVE — variables d'environnement ───────────────────────────────
# Développement local : copier en .env puis `npm run dev`.
# Railway : onglet « Variables » de chaque service.

# ── Obligatoires ──
NODE_ENV=production
# Railway : ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/ocdlive
# Chaîne aléatoire longue (ex. : openssl rand -base64 36). Ne jamais la publier.
APP_SECRET=remplacer-par-une-longue-chaine-aleatoire

# ── Premier super administrateur (créé au premier démarrage si aucun compte n'existe) ──
ADMIN_EMAIL=bovann@exemple.com
ADMIN_PASSWORD=au-moins-10-caracteres
ADMIN_NAME=Bovann

# Adresse publique du site (liens dans les emails)
PUBLIC_URL=https://ocdlive.exemple.com

# ── Paiement ──
# manual = Mobile Money confirmé par l'équipe ; demo = simulation (validation du projet uniquement)
PAYMENT_PROVIDER=manual
PAYMENT_MANUAL_NUMBER=+228 90 00 00 00
PAYMENT_MANUAL_NAME=OCD
# Obligatoire pour PAYMENT_PROVIDER=demo quand NODE_ENV=production
ALLOW_DEMO_PAYMENTS=false

# ── Emails (facultatif) : Resend (recommandé sur Railway) ou SMTP ──
TEAM_EMAILS=equipe@exemple.com,bovann@exemple.com
MAIL_FROM=OCD LIVE <reservations@exemple.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Redis (facultatif) : limitation des requêtes partagée entre instances ──
# Railway : ${{Redis.REDIS_URL}}
REDIS_URL=

# ── Exploitation ──
# 1 derrière Railway, 2 derrière Cloudflare + Railway
TRUST_PROXY=1
DB_POOL_MAX=10
# true = le service web fait aussi le travail du worker (petite installation, un seul service)
RUN_WORKER_IN_WEB=false
WORKER_INTERVAL_MS=15000
MIGRATE_ON_BOOT=true
ADMIN_SESSION_HOURS=12
