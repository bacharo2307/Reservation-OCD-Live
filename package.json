{
  "name": "ocd-live",
  "version": "1.0.0",
  "private": true,
  "description": "OCD LIVE — réservation des lives commerciaux OCD (PWA + API + worker), hébergée sur Railway",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "create-admin": "node src/scripts/create-admin.js",
    "seed:demo": "node src/scripts/demo-data.js seed",
    "demo:reset": "node src/scripts/demo-data.js reset",
    "test": "node --test --test-concurrency=1 tests/booking.test.js tests/http.test.js tests/ai.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
